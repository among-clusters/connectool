{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["global", "dex", "toolhive", "codex"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["issuer", "scopes"],
      "properties": {
        "issuer": {"type": "string", "pattern": "^https://"},
        "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "dex": {
      "type": "object",
      "required": ["contract"],
      "properties": {"contract": {"type": "object", "required": ["enabled", "namespace"], "properties": {"enabled": {"type": "boolean"}, "namespace": {"type": "string", "minLength": 1}, "configMapName": {"type": "string"}}}}
    },
    "toolhive": {
      "type": "object",
      "required": ["namespace", "placement", "registry", "sessionStorage", "sessionRouting", "publications"],
      "properties": {
        "namespace": {"type": "string", "minLength": 1},
        "placement": {
          "type": "object",
          "required": ["nodeSelector", "affinity", "tolerations", "topologySpreadConstraints", "resources"],
          "properties": {
            "nodeSelector": {
              "type": "object",
              "additionalProperties": {"type": "string"}
            },
            "affinity": {"type": "object"},
            "tolerations": {"type": "array", "items": {"type": "object"}},
            "topologySpreadConstraints": {"type": "array", "items": {"type": "object"}},
            "resources": {
              "type": "object",
              "properties": {
                "requests": {"type": "object", "additionalProperties": {"type": "string"}},
                "limits": {"type": "object", "additionalProperties": {"type": "string"}}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "runtimePolicy": {
          "type": "object",
          "required": ["enabled", "nodeNames", "trafficDistribution", "backendSessionAffinity", "proxyResources", "rollout"],
          "properties": {
            "enabled": {"type": "boolean"},
            "nodeNames": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "trafficDistribution": {"type": "string", "enum": ["PreferSameNode", "PreferSameZone", "PreferClose"]},
            "backendSessionAffinity": {"const": "None"},
            "proxyResources": {
              "type": "object",
              "required": ["requests", "limits"],
              "properties": {
                "requests": {"type": "object", "additionalProperties": {"type": "string"}},
                "limits": {"type": "object", "additionalProperties": {"type": "string"}}
              },
              "additionalProperties": false
            },
            "rollout": {
              "type": "object",
              "required": ["maxUnavailable", "maxSurge", "progressDeadlineSeconds"],
              "properties": {
                "maxUnavailable": {"type": "integer", "minimum": 0},
                "maxSurge": {"type": "integer", "minimum": 0},
                "progressDeadlineSeconds": {"type": "integer", "minimum": 30}
              },
              "additionalProperties": false
            }
          },
          "allOf": [
            {"if": {"properties": {"enabled": {"const": true}}}, "then": {"properties": {"nodeNames": {"minItems": 1}}}}
          ],
          "additionalProperties": false
        },
        "registry": {"type": "object", "required": ["enabled", "name", "sources"], "properties": {"enabled": {"type": "boolean"}, "name": {"type": "string", "minLength": 1}, "sources": {"type": "array"}}},
        "sessionStorage": {
          "oneOf": [
            {
              "type": "object",
              "required": ["provider", "sessionAffinity"],
              "properties": {"provider": {"const": "memory"}, "sessionAffinity": {"const": "ClientIP"}},
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["provider", "sessionAffinity", "address", "passwordSecretRef"],
              "properties": {
                "provider": {"const": "redis"},
                "sessionAffinity": {"type": "string", "enum": ["ClientIP", "None"]},
                "address": {"type": "string", "minLength": 1},
                "passwordSecretRef": {
                  "type": "object",
                  "required": ["name", "key"],
                  "properties": {"name": {"type": "string", "minLength": 1}, "key": {"type": "string", "minLength": 1}},
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "sessionRouting": {
          "type": "object",
          "required": ["enabled", "replicas", "image", "listenPort", "servicePort", "backendPort", "sessionHeader", "resources"],
          "properties": {
            "enabled": {"type": "boolean"},
            "replicas": {"type": "integer", "minimum": 2},
            "image": {
              "type": "object",
              "required": ["repository", "tag", "digest", "pullPolicy"],
              "properties": {
                "repository": {"type": "string", "minLength": 1},
                "tag": {"type": "string"},
                "digest": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"},
                "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
              },
              "additionalProperties": false
            },
            "listenPort": {"type": "integer", "minimum": 1, "maximum": 65535},
            "servicePort": {"type": "integer", "minimum": 1, "maximum": 65535},
            "backendPort": {"type": "integer", "minimum": 1, "maximum": 65535},
            "sessionHeader": {"const": "Mcp-Session-Id"},
            "resources": {
              "type": "object",
              "required": ["requests", "limits"],
              "properties": {
                "requests": {"type": "object", "additionalProperties": {"type": "string"}},
                "limits": {"type": "object", "additionalProperties": {"type": "string"}}
              },
              "additionalProperties": false
            }
          },
          "allOf": [
            {
              "if": {"properties": {"enabled": {"const": true}}},
              "then": {"properties": {"replicas": {"minimum": 2}}}
            }
          ],
          "additionalProperties": false
        },
        "publications": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "clientId", "resourceUrl", "group", "workloads", "authorization"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
              "clientId": {"type": "string", "minLength": 1},
              "resourceUrl": {"type": "string", "pattern": "^https://"},
              "group": {"type": "string", "minLength": 1},
              "replicas": {"type": "integer", "minimum": 1},
              "allowSingleReplicaWhenCapacityLimited": {"type": "boolean"},
              "sessionAffinity": {"type": "string", "enum": ["ClientIP", "None"]},
              "workloads": {"type": "array", "minItems": 1},
              "authorization": {"type": "object", "required": ["groupClaim", "policies"]},
              "outgoingAuth": {
                "type": "object",
                "properties": {
                  "source": {"type": "string", "enum": ["discovered", "inline"]},
                  "default": {"$ref": "#/definitions/backendAuth"},
                  "backends": {"type": "object", "additionalProperties": {"$ref": "#/definitions/backendAuth"}}
                },
                "additionalProperties": false
              },
              "operational": {
                "type": "object",
                "properties": {
                  "logLevel": {"type": "string", "enum": ["debug"]},
                  "failureHandling": {
                    "type": "object",
                    "properties": {
                      "partialFailureMode": {"type": "string", "enum": ["fail", "best_effort"]},
                      "healthCheckInterval": {"type": "string", "minLength": 1},
                      "healthCheckTimeout": {"type": "string", "minLength": 1},
                      "statusReportingInterval": {"type": "string", "minLength": 1},
                      "unhealthyThreshold": {"type": "integer", "minimum": 1},
                      "circuitBreaker": {
                        "type": "object",
                        "properties": {
                          "enabled": {"type": "boolean"},
                          "failureThreshold": {"type": "integer", "minimum": 1},
                          "timeout": {"type": "string", "minLength": 1}
                        },
                        "additionalProperties": false
                      }
                    },
                    "additionalProperties": false
                  },
                  "timeouts": {
                    "type": "object",
                    "properties": {
                      "default": {"type": "string", "minLength": 1},
                      "backendInit": {"type": "string", "minLength": 1},
                      "perWorkload": {
                        "type": "object",
                        "additionalProperties": {"type": "string", "minLength": 1}
                      }
                    },
                    "additionalProperties": false
                  },
                  "listChanged": {
                    "type": "object",
                    "properties": {
                      "enabled": {"type": "boolean"},
                      "disabledWorkloads": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": {"type": "string", "minLength": 1}
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              "audit": {
                "type": "object",
                "properties": {
                  "enabled": {"type": "boolean"},
                  "component": {"type": "string", "minLength": 1},
                  "includeRequestData": {"type": "boolean"},
                  "includeResponseData": {"type": "boolean"}
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "codex": {
      "type": "object",
      "required": ["marketplace", "plugins"],
      "properties": {
        "marketplace": {"type": "object", "required": ["name", "displayName", "source"], "properties": {"name": {"type": "string", "minLength": 1}, "displayName": {"type": "string", "minLength": 1}, "source": {"type": "string", "pattern": "^https://"}}},
        "plugins": {"type": "array", "items": {"type": "object", "required": ["name", "publication", "mcpOwner", "skills"], "properties": {"name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}, "publication": {"type": "string", "minLength": 1}, "mcpOwner": {"type": "boolean"}, "skills": {"type": "array", "items": {"type": "string"}}}}}
      }
    },
    "distribution": {
      "type": "object",
      "required": ["updated", "channels"],
      "properties": {
        "updated": {"type": "string"},
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "surfaces", "entryClass", "status", "integration", "detail"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
              "surfaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "entryClass": {"type": "string", "enum": ["self-service", "official-review", "unavailable"]},
              "status": {"type": "string", "minLength": 1},
              "integration": {"type": "string", "minLength": 1},
              "publication": {"type": "string", "minLength": 1},
              "artifact": {"type": "string", "minLength": 1},
              "detail": {"type": "string", "minLength": 1},
              "documentation": {"type": "string", "pattern": "^https://"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "backendAuth": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "enum": ["discovered", "externalAuthConfigRef"]},
        "externalAuthConfigRef": {
          "type": "object",
          "required": ["name"],
          "properties": {"name": {"type": "string", "minLength": 1}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
