FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY cmd/session-router ./cmd/session-router
RUN CGO_ENABLED=0 go test ./cmd/session-router && \
    CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/session-router ./cmd/session-router

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/session-router /session-router
USER 65532:65532
ENTRYPOINT ["/session-router"]
